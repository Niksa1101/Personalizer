# Personalizer — environment configuration
#
# Copy this file to .env.local and fill every value. All eight are required;
# the app and the worker both refuse to start if any is missing.
# See docs/Tech.md §14.1.

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. Bypasses RLS on every table (docs/DB.md §7).
# Server-side only — never expose to a client bundle, and NEVER put this in
# GitHub secrets (the keep-alive action uses a separate insert-only anon key,
# docs/Tech.md §15).
SUPABASE_SERVICE_ROLE_KEY=

# --- Netlify ------------------------------------------------------------------
# The one shared site that hosts every landing page. Created manually.
NETLIFY_SITE_ID=

# Personal access token with deploy rights on that site.
NETLIFY_TOKEN=

# --- Local storage ------------------------------------------------------------
# Absolute path to the media root. Recordings, masters and intros live here.
# Windows example: C:\personalizer-media
LOCAL_STORAGE_ROOT=

# --- Queue --------------------------------------------------------------------
# Redis connection for BullMQ. Docker default below.
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---------------------------------------------------------------------
# The single admin password.
APP_PASSWORD=

# HS256 signing key for the session cookie. Minimum 32 characters.
# Quote the value if it contains # (dotenv treats # as a comment otherwise).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Verification only (optional) ---------------------------------------------
# NOT one of the eight. Neither the app nor the worker reads it, and nothing
# refuses to start without it.
#
# The project's anon key. `npm run verify:dashboard`, `verify:schema`, and
# `verify:keepalive` use it to assert from the outside that the `anon` role
# cannot reach tables and functions it should not — the grant is revoked in
# the migration, and this is what proves the revoke actually holds.
# Left unset, those checks report as skipped rather than passed.
#
# The same key value goes into the SUPABASE_ANON_KEY GitHub secret used by the
# keep-alive workflow — see docs/Tech.md §15.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
