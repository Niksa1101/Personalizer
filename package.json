{
  "name": "personalizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "worker": "tsx --conditions react-server --env-file-if-exists=.env.local worker/index.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "verify:imports": "tsx scripts/verify-imports.ts",
    "verify:auth": "tsx --env-file-if-exists=.env.local scripts/verify-auth.ts",
    "verify:shell": "tsx --env-file-if-exists=.env.local scripts/verify-shell.ts",
    "verify:campaigns": "tsx --env-file-if-exists=.env.local scripts/verify-campaigns.ts",
    "verify:import": "tsx --env-file-if-exists=.env.local scripts/verify-import.ts",
    "verify:intros": "tsx --env-file-if-exists=.env.local scripts/verify-intros.ts",
    "verify:worker": "tsx --conditions react-server --env-file-if-exists=.env.local scripts/verify-worker.ts",
    "verify:record": "tsx --conditions react-server --env-file-if-exists=.env.local scripts/verify-record.ts",
    "verify:merge": "tsx --conditions react-server scripts/verify-merge.ts",
    "verify:page": "tsx scripts/verify-page.ts",
    "setup:browser": "playwright install chromium",
    "verify:server-only": "tsx scripts/verify-server-only.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.80.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "playwright": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
